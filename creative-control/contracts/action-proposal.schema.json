{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ca0sc0rp.github.io/art-Design-Music/creative-control/contracts/action-proposal.schema.json",
  "title": "ADM Creative Control Action Proposal",
  "description": "Propuesta declarativa de acciones creativas. No concede permisos ni ejecuta operaciones.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "proposalId",
    "projectVersion",
    "workspace",
    "summary",
    "actions"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "proposalId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "projectVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "workspace": {
      "enum": [
        "character",
        "rig",
        "animation",
        "scenes",
        "audio",
        "playlist",
        "timeline"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 300
      },
      "maxItems": 20
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "targetId",
              "transform"
            ],
            "properties": {
              "type": {
                "const": "set_part_transform"
              },
              "targetId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "transform": {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "rotation": {
                    "type": "number"
                  },
                  "scale": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "poseId"
            ],
            "properties": {
              "type": {
                "const": "apply_pose"
              },
              "poseId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "chainId",
              "target"
            ],
            "properties": {
              "type": {
                "const": "solve_ik"
              },
              "chainId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "target": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "x",
                  "y"
                ],
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  }
                }
              },
              "bend": {
                "enum": [
                  -1,
                  1
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "expression"
            ],
            "properties": {
              "type": {
                "const": "set_expression"
              },
              "expression": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            }
          }
        ]
      }
    }
  }
}
